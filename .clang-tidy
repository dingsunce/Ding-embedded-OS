---
# Enable safety, platform bug detection, and Microsoft style enforcement
Checks: >
  -*,
  bugprone-*,
  cert-*,
  performance-*,
  readability-*,
  -readability-braces-around-statements
  
# Raise safety and performance flaws to build-breaking errors
WarningsAsErrors: 'bugprone-*,performance-*,cert-*'

CheckOptions:
  # Enforce Microsoft / Windows API PascalCase and camelCase Naming Rules
  - key:             readability-identifier-naming.ClassCase
    value:           PascalCase
  - key:             readability-identifier-naming.StructCase
    value:           PascalCase
  - key:             readability-identifier-naming.TypedefCase
    value:           PascalCase
  
  # Microsoft style uses PascalCase for Public/Global Functions
  - key:             readability-identifier-naming.FunctionCase
    value:           PascalCase
  
  # Local variables and parameters follow camelCase
  - key:             readability-identifier-naming.VariableCase
    value:           camelCase
  - key:             readability-identifier-naming.ParameterCase
    value:           camelCase

  # Ignore macro style errors (very common in Windows SDK headers)
  - key:             cppcoreguidelines-macro-usage.AllowedRegexp
    value:           '^_[A-Z0-9_]+'

  # Prevent massive functions from passing code reviews
  - key:             readability-function-size.LineThreshold
    value:           100
...
